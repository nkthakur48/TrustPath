PROJECT_NAME="TrustPath API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Get a key at https://openrouter.ai/keys. Leave empty to run rules-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gmail scan (optional). Google Cloud Console: enable Gmail API, create an OAuth client (Web),
# add redirect URI http://localhost:8000/api/v1/gmail/callback, add your account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
